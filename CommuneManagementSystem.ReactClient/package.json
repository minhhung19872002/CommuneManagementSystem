{
  "name": "communemanagementsystem-reactclient",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node ./scripts/dev-stack.mjs",
    "dev:frontend": "vite",
    "dev:e2e": "vite --host 127.0.0.1 --port 4173",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "e2e:serve": "node ./scripts/e2e-stack.mjs",
    "playwright:install": "playwright install chromium",
    "playwright:test:raw": "playwright test",
    "playwright:test:headed:raw": "playwright test --headed",
    "playwright:test": "start-server-and-test e2e:serve http://127.0.0.1:4173/login playwright:test:raw",
    "playwright:test:headed": "start-server-and-test e2e:serve http://127.0.0.1:4173/login playwright:test:headed:raw",
    "cypress:run:raw": "cypress run",
    "cypress:run": "start-server-and-test e2e:serve http://127.0.0.1:4173/login cypress:run:raw",
    "cypress:open": "cypress open"
  },
  "dependencies": {
    "@ant-design/cssinjs": "^2.1.2",
    "@ant-design/icons": "^6.1.1",
    "@rolldown/binding-win32-x64-msvc": "^1.0.0-rc.13",
    "antd": "^6.3.5",
    "axios": "^1.14.0",
    "lucide-react": "^1.7.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.14.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.27",
    "cypress": "^15.13.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "postcss": "^8.5.8",
    "start-server-and-test": "^3.0.0",
    "tailwindcss": "^4.2.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.4"
  }
}
